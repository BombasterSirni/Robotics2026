<?xml version="1.0"?>
<!-- Модель Ackermann-робота: SI, оси REP-103. Размеры взяты из
     models/course_ackermann/model.sdf (только геометрия, без Gazebo-плагинов). -->
<robot name="course_ackermann" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- База и колёса: метры, килограммы. -->
  <xacro:property name="base_length" value="1.05"/>
  <xacro:property name="base_width" value="0.52"/>
  <xacro:property name="base_height" value="0.22"/>
  <xacro:property name="base_clearance" value="0.12"/>
  <xacro:property name="track" value="0.62"/>
  <xacro:property name="wheelbase" value="0.80"/>
  <xacro:property name="wheel_radius" value="0.12"/>
  <xacro:property name="wheel_width" value="0.07"/>

  <!-- Сенсоры: смещения от base_link, метры. -->
  <xacro:property name="camera_xyz" value="0.28 0.0 0.38"/>
  <xacro:property name="lidar_xyz" value="-0.05 0.0 0.45"/>
  <xacro:property name="imu_xyz" value="0.0 0.0 0.24"/>

  <!-- Массы: килограммы. -->
  <xacro:property name="base_mass" value="12.0"/>
  <xacro:property name="wheel_mass" value="0.8"/>
  <xacro:property name="sensor_mass" value="0.0333"/>

  <xacro:macro name="box_inertial" params="mass x y z">
    <inertial>
      <mass value="${mass}"/>
      <inertia ixx="${mass * (y * y + z * z) / 12.0}" ixy="0.0" ixz="0.0"
               iyy="${mass * (x * x + z * z) / 12.0}" iyz="0.0"
               izz="${mass * (x * x + y * y) / 12.0}"/>
    </inertial>
  </xacro:macro>

  <link name="base_link">
    <xacro:box_inertial mass="${base_mass}" x="${base_length}"
                        y="${base_width}" z="${base_height}"/>
    <visual>
      <origin xyz="0 0 ${base_clearance}" rpy="0 0 0"/>
      <geometry>
        <box size="${base_length} ${base_width} ${base_height}"/>
      </geometry>
      <material name="body_blue">
        <color rgba="0.05 0.36 0.72 1.0"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 ${base_clearance}" rpy="0 0 0"/>
      <geometry>
        <box size="${base_length} ${base_width} ${base_height}"/>
      </geometry>
    </collision>
  </link>

  <xacro:macro name="wheel" params="name x y">
    <link name="${name}">
      <inertial>
        <mass value="${wheel_mass}"/>
        <inertia ixx="${wheel_mass * (3 * wheel_radius * wheel_radius + wheel_width * wheel_width) / 12.0}"
                 ixy="0.0" ixz="0.0"
                 iyy="${wheel_mass * wheel_radius * wheel_radius / 2.0}" iyz="0.0"
                 izz="${wheel_mass * (3 * wheel_radius * wheel_radius + wheel_width * wheel_width) / 12.0}"/>
      </inertial>
      <visual>
        <origin xyz="0 0 0" rpy="1.5707963267948966 0 0"/>
        <geometry>
          <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
        </geometry>
        <material name="wheel_black">
          <color rgba="0.04 0.04 0.04 1.0"/>
        </material>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="1.5707963267948966 0 0"/>
        <geometry>
          <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
        </geometry>
      </collision>
    </link>
    <joint name="${name}_joint" type="continuous">
      <parent link="base_link"/>
      <child link="${name}"/>
      <origin xyz="${x} ${y} 0.0" rpy="0 0 0"/>
      <axis xyz="0 1 0"/>
    </joint>
  </xacro:macro>

  <xacro:wheel name="front_left_wheel" x="${wheelbase / 2.0}" y="${track / 2.0}"/>
  <xacro:wheel name="front_right_wheel" x="${wheelbase / 2.0}" y="${-track / 2.0}"/>
  <xacro:wheel name="rear_left_wheel" x="${-wheelbase / 2.0}" y="${track / 2.0}"/>
  <xacro:wheel name="rear_right_wheel" x="${-wheelbase / 2.0}" y="${-track / 2.0}"/>

  <xacro:macro name="sensor" params="name xyz size parent:='base_link'">
    <link name="${name}">
      <xacro:box_inertial mass="${sensor_mass}" x="${size}" y="${size}" z="${size}"/>
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <box size="${size} ${size} ${size}"/>
        </geometry>
        <material name="sensor_gray">
          <color rgba="0.35 0.35 0.35 1.0"/>
        </material>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <box size="${size} ${size} ${size}"/>
        </geometry>
      </collision>
    </link>
    <joint name="${name}_joint" type="fixed">
      <parent link="${parent}"/>
      <child link="${name}"/>
      <origin xyz="${xyz}" rpy="0 0 0"/>
    </joint>
  </xacro:macro>

  <xacro:sensor name="camera_link" xyz="${camera_xyz}" size="0.05"/>
  <xacro:sensor name="lidar_link" xyz="${lidar_xyz}" size="0.06"/>
  <xacro:sensor name="imu_link" xyz="${imu_xyz}" size="0.04"/>

</robot>
